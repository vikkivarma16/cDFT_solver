#interactions primary: cc: type =  hc,  sigma = 1.0, cutoff = 3.5, epsilon = 2.0

# --- secondary interactions ---
#interactions secondary: aa: type = ghc,  sigma = 1.0, cutoff = 3.2, epsilon = 2.0
#interaction secondary: aa: type = ma,  sigma = 1.000, cutoff = 3.5, epsilon = 0.1787, m = 12, n = 6, lambda = 0.477246
#interactions secondary: bb: type = ghc,  sigma = 1.0, cutoff = 3.2, epsilon = 2.0

# --- rdf calculation parameter ---
rdf closure aa = hnc
rdf closure ab = py
#rdf closure ac = py
rdf closure bb = py
#rdf closure bc = py
#rdf closure cc = py

rdf alpha_max =  0.1
rdf max_iteration  = 40000
rdf max_iteration_ibi = 10000
rdf alpha_ibi_max  = 0.1
rdf tolerance = 0.00001
rdf ibi_tolerance  = 0.0001
rdf beta = 1.0
rdf r_max  =  20.0
rdf n_points =  2000

supplied_data states 1 rdf aa: filename = average_g11.txt
supplied_data states 1 rdf ab: filename = average_g12.txt
supplied_data states 1 rdf bb: filename = average_g22.txt
supplied_data states 1 densities a = 0.109860935
supplied_data states 1 densities b = 0.022041065
supplied_data states 1 beta = 1.0
